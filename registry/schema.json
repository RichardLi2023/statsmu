{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RichardLi2023/statsmu/registry/schema.json",
  "title": "Source registry entry (Module 1 contract v1, section 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "publisher", "connector", "address", "frequency", "check_every",
    "licence", "credit_line", "access_rule", "themes", "checks", "active"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,62}$" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "connector": { "enum": ["sdmx"] },
    "address": { "type": "object" },
    "frequency": { "enum": ["daily", "weekly", "monthly", "quarterly", "annual", "irregular"] },
    "check_every": { "enum": ["day", "week", "month"] },
    "expected_release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "months": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 },
          "uniqueItems": true
        },
        "note": { "type": "string" }
      }
    },
    "licence": {
      "enum": ["free_with_credit", "all_rights_reserved", "cc_by", "cc_by_sa", "odc_by", "terms_to_confirm"]
    },
    "licence_note": { "type": "string" },
    "credit_line": { "type": "string", "minLength": 1 },
    "access_rule": { "enum": ["by_tier", "free_to_all"] },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$" }
    },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "active": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "licence": { "enum": ["all_rights_reserved", "terms_to_confirm"] } } },
      "then": { "properties": { "access_rule": { "const": "free_to_all" } } }
    },
    {
      "if": { "properties": { "connector": { "const": "sdmx" } } },
      "then": { "properties": { "address": { "$ref": "#/$defs/sdmx_address" } } }
    }
  ],
  "$defs": {
    "sdmx_address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "agency", "dataflow", "version"],
      "properties": {
        "base_url": { "type": "string", "pattern": "^https://.+/$" },
        "agency": { "type": "string", "minLength": 1 },
        "dataflow": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": { "type": { "const": "min_rows" }, "value": { "type": "integer", "minimum": 0 } },
          "required": ["value"], "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "required_dimensions" },
            "dimensions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "required": ["dimensions"], "additionalProperties": false
        },
        { "properties": { "type": { "const": "unique_key" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "numeric_values" } }, "additionalProperties": false },
        {
          "properties": {
            "type": { "const": "periods_complete" },
            "from": { "type": "string", "pattern": "^\\d{4}(-Q[1-4]|-\\d{2})?$" }
          },
          "required": ["from"], "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "sum_equals" },
            "dimension": { "type": "string" },
            "total": { "type": "string" },
            "tolerance": { "type": "number", "minimum": 0 }
          },
          "required": ["dimension", "total"], "additionalProperties": false
        }
      ]
    }
  }
}
